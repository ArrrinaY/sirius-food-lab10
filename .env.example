# Пример файла с секретами. Скопируйте в .env и подставьте свои значения.
# .env не попадает в Git (см. .gitignore) — это принцип Secure by Default.

# Секрет для подписи JWT. Сменить в продакшене!
SECRET_KEY=change-me-to-a-long-random-string

# Подключение к PostgreSQL из docker-compose
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food

# Хост-порт контейнера PostgreSQL (нужен, только если 5432 занят другим
# PostgreSQL на вашей машине; не забудьте указать его и в DATABASE_URL)
# DB_PORT=5433

# Redis для rate limiting и кеша меню (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Кеширование меню на Redis (ЛР № 4). false — режим baseline:
# каждый запрос к меню идёт в PostgreSQL (для замеров «до кеша»)
CACHE_ENABLED=true

# API-окружение:
#   DEBUG=True  — локальная разработка: Swagger на /docs включён
#   DEBUG=False — продакшен: Swagger отключён (Secure by Default)
DEBUG=True

# Разрешённые CORS-источники через запятую (пустое значение —
# браузерные запросы с внешних доменов запрещены).
ALLOWED_ORIGINS=https://sirius-food.ru,https://app.sirius-food.ru
