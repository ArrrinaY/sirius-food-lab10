
{
  "uid": "sirius-lab9",
  "title": "Сириус.Еда — наблюдаемость",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "RPS: создание и оплата заказа",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(sirius_http_requests_total{method=\"POST\",route=~\"/orders/create|/orders/\\\\{order_id\\\\}/pay\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "sirius-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Задержка p95: список меню",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sirius_http_request_duration_seconds_bucket{method=\"GET\",route=\"/menu/items\"}[1m])))",
          "refId": "A",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "sirius-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Ошибки HTTP 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(sirius_http_requests_total{status=~\"5..\"}[1m])) or (0 * sum(up{job=\"sirius_app\"} == 1))",
          "refId": "A",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "sirius-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Сообщения в очереди кухни",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages{queue=\"kitchen_queue\"})",
          "refId": "A",
          "legendFormat": "kitchen_queue",
          "datasource": {
            "type": "prometheus",
            "uid": "sirius-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Доля попаданий в кеш Redis",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(redis_keyspace_hits_total[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])), 1e-9)",
          "refId": "A",
          "legendFormat": "hit rate",
          "datasource": {
            "type": "prometheus",
            "uid": "sirius-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Загрузка CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Использование RAM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A",
          "legendFormat": "RAM usage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Использование диска",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Сетевой трафик",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
          "refId": "A",
          "legendFormat": "Входящий {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
          "refId": "B",
          "legendFormat": "Исходящий {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Время работы сервера",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds",
          "refId": "A",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
